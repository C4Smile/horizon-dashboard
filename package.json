{
  "name": "horizon-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:config": "eslint --print-config \"src/**/*.{js,jsx,ts,tsx}\"",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "firebase": "firebase deploy --only hosting:museo-dashboard"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@fontsource/poppins": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.3.0",
    "@fortawesome/free-brands-svg-icons": "^6.3.0",
    "@fortawesome/free-regular-svg-icons": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@loadable/component": "^5.16.3",
    "@tailwindcss/vite": "^4.0.11",
    "@tanstack/react-query": "5.40",
    "@sito/dashboard": "^0.0.17",
    "@supabase/supabase-js": "^2.39.7",
    "autoprefixer": "^10.4.16",
    "chart.js": "^4.4.1",
    "chartjs-adapter-moment": "^1.0.1",
    "draftjs-to-html": "^0.9.1",
    "html-to-draftjs": "^1.5.0",
    "i18next": "^23.7.11",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.2",
    "moment": "^2.29.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-draft-wysiwyg": "^1.15.0",
    "react-flatpickr": "^3.10.13",
    "react-i18next": "^13.4.0",
    "react-router-dom": "^6.20.1",
    "react-tooltip": "^5.28.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.0.11",
    "react-transition-group": "^4.4.5",
    "some-javascript-utils": "^0.10.4",
    "swr": "^2.2.4",
    "react-hook-form": "^7.51.0",
    "use-lodash-debounce": "^1.3.0"
