{
  "name": "horizon-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier . --check",
    "lint": "oxlint --type-aware --max-warnings 0",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc -b",
    "deploy": "firebase deploy --only hosting:horizon-dashboard"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@fontsource/poppins": "5.2.6",
    "@fortawesome/fontawesome-svg-core": "7.0.0",
    "@fortawesome/free-brands-svg-icons": "7.0.0",
    "@fortawesome/free-regular-svg-icons": "7.0.0",
    "@fortawesome/free-solid-svg-icons": "7.0.0",
    "@fortawesome/react-fontawesome": "3.4.0",
    "@loadable/component": "5.16.7",
    "@sito/dashboard-app": "0.2.1",
    "@supabase/supabase-js": "^2.100.0",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-query": "5.83.0",
    "i18next": "25.3.2",
    "i18next-browser-languagedetector": "8.2.0",
    "i18next-http-backend": "^2.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.0.0",
    "react-hook-form": "7.61.1",
    "react-i18next": "15.6.1",
    "react-router-dom": "7.18.2",
    "react-simple-wysiwyg": "^3.4.1",
    "react-tooltip": "5.29.1",
    "some-javascript-utils": "0.10.10",
    "tailwindcss": "4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/loadable__component": "5.13.10",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-mkcert": "1.17.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": "^22.13.0"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ],
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.24",
      "undici": "7.29.0",
      "tar": "7.5.8",
      "minimatch": "10.2.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "i18next>typescript": "7",
        "react-i18next>typescript": "7"
      }
    }
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "undici": "7.29.0",
    "tar": "7.5.8",
    "minimatch": "10.2.3"
  }
}
